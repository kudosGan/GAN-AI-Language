print(len("héllo"))
print(str(42) + "!")
print(num("3.5") * 2)
print(abs(-4))
print(min(3, 8))
print(max(3, 8))
print(sqrt(16))
print(pow(2, 10))
print(round(2.6))
print(floor(2.6))
