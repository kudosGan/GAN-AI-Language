print(lower("GAN"))
print(contains([1, 2, 3], 2))
print(contains("hello", "ell"))

func sum(list) {
    let t = 0
    for x in list {
        t = t + x
    }
    return t
}
print(sum([1, 2, 3, 4]))

// a function you write wins over a built-in with the same name
func len(x) {
    return "my own len"
}
print(len([1, 2]))
