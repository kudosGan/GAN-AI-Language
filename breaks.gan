// continue skips a pass, break stops the loop
for i in 1 to 10 {
    if i == 3 {
        continue
    }
    if i == 6 {
        break
    }
    print(i)
}
print("done")

// they work in while loops too
let n = 0
while true {
    n = n + 1
    if n == 3 {
        break
    }
}
print(n)

// only the nearest (inner) loop is affected
for row in 1 to 2 {
    for col in 1 to 5 {
        if col == 3 {
            break
        }
        print(str(row) + "-" + str(col))
    }
}
