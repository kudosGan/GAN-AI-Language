// A tiny model learns to double a number.
// It has one weight. The right answer for the weight is 2.
let x = tensor([[1], [2]])
let target = tensor([[2], [4]])      // each answer is x doubled
var w = learnable(tensor([[0]]))     // the model's first guess

for round in 1 to 3 {
    let diff = matmul(x, w) - target
    let loss = sum(diff * diff)      // how wrong the model is
    backward(loss)
    print("loss " + item(loss) + ", gradient " + grad(w))
    w = learnable(w - 0.05 * grad(w))   // take a small step
    print(w)
}
