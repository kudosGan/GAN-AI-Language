// A tensor is a grid of numbers. These two have 2 rows and 2 columns.
let a = tensor([[1, 2], [3, 4]])
let b = tensor([[5, 6], [7, 8]])
print(a)
print(shape(a))
print(a + b)
print(a * 10)
print(a * b)            // multiplies matching positions
print(matmul(a, b))     // matrix multiplication
print(sum(a))
print(typeof(a))
