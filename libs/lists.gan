// GAN standard library: lists
// Use it with:  import "lists"   then   lists.sorted([3, 1, 2])

// range(1, 5) is [1, 2, 3, 4, 5]
func range(from, to) {
    let result = []
    for i in from to to {
        push(result, i)
    }
    return result
}

func reverse(list) {
    let result = []
    for item in list {
        result = [item] + result
    }
    return result
}

// a new list with the numbers in order, smallest first (the original is not changed)
func sorted(list) {
    let result = list + []
    let n = len(result)
    let i = 0
    while i < n {
        let j = 0
        while j < n - i - 1 {
            if result[j] > result[j + 1] {
                let temp = result[j]
                result[j] = result[j + 1]
                result[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    return result
}

func first(list) {
    if len(list) == 0 {
        fail("first needs a list with at least one item")
    }
    return list[0]
}

func last(list) {
    if len(list) == 0 {
        fail("last needs a list with at least one item")
    }
    return list[len(list) - 1]
}
