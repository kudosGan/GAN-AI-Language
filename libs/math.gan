// GAN standard library: math
// Use it with:  import "math"   then   math.square(5)

final PI = 3.141592653589793
final E = 2.718281828459045

func square(x) {
    return x * x
}

func cube(x) {
    return x * x * x
}

// 1 for positive numbers, -1 for negative, 0 for zero
func sign(x) {
    if x > 0 {
        return 1
    } else if x < 0 {
        return -1
    }
    return 0
}

// keeps x between low and high
func clamp(x, low, high) {
    return max(low, min(x, high))
}

func isEven(n) {
    return n % 2 == 0
}

func isOdd(n) {
    return n % 2 != 0
}

func factorial(n) {
    let result = 1
    for i in 2 to n {
        result = result * i
    }
    return result
}

// greatest common divisor (Euclid's method)
func gcd(a, b) {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

func isPrime(n) {
    if n < 2 {
        return false
    }
    for d in 2 to floor(sqrt(n)) {
        if n % d == 0 {
            return false
        }
    }
    return true
}

func sumOf(list) {
    let total = 0
    for x in list {
        total = total + x
    }
    return total
}

func average(list) {
    if len(list) == 0 {
        fail("average needs a list with at least one number")
    }
    return sumOf(list) / len(list)
}

func maxOf(list) {
    if len(list) == 0 {
        fail("maxOf needs a list with at least one number")
    }
    let best = list[0]
    for x in list {
        if x > best {
            best = x
        }
    }
    return best
}

func minOf(list) {
    if len(list) == 0 {
        fail("minOf needs a list with at least one number")
    }
    let best = list[0]
    for x in list {
        if x < best {
            best = x
        }
    }
    return best
}
